# 환경 변수는 실행 전에 PowerShell의 $env:변수명 으로 설정하세요.
PORT=3100
HOST=127.0.0.1
APP_URL=http://localhost:3100
DATABASE_PATH=./data/moneycheck.sqlite
# 이메일 재설정: Resend에서 인증한 발신 주소와 API 키
RESEND_API_KEY=
MAIL_FROM=
# HTTPS로 배포할 때 1로 설정
COOKIE_SECURE=0
# Vercel 영구 저장소 (Neon 등 PostgreSQL)
DATABASE_URL=
# 공개 배포 시 첫 관리자 가입에 사용할 이메일
ADMIN_EMAIL=
# Vercel 정기 구독료 기록 요청의 인증용 임의 비밀 값
CRON_SECRET=
